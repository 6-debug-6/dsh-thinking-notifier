    "url": "https://github.com/YOUR_GITHUB_USERNAME/dsh-thinking-notifier/issues"
  },
  "homepage": "https://github.com/YOUR_GITHUB_USERNAME/dsh-thinking-notifier#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "thinking",
    "notifier",
    "desktop-popup",
    "permission",
    "deepseek"
  ]
}
